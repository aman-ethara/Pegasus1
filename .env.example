# Environment configuration
PORT=3000
LOG_LEVEL=info

# Shopify mock credentials
SHOPIFY_API_KEY=shp_api_key_example
SHOPIFY_SHOP=example.myshopify.com

# Razorpay mock credentials
RAZORPAY_KEY_ID=rzp_test_key
RAZORPAY_KEY_SECRET=rzp_test_secret

# Webhook signing secret (used to verify Razorpay webhooks)
WEBHOOK_SECRET=whsec_dev

# Resilience settings
HTTP_TIMEOUT_MS=5000
RETRY_ATTEMPTS=3
RETRY_BACKOFF_MS=200
